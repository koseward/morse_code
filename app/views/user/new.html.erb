<h1 class="display-3">Register New User</h1>

<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>

<%= form_with url: user_path(params[:token]) do |form| %>
  <%= form.password_field :email, required: true, autocomplete: "new-password", placeholder: "Enter new email address", class: "form-control", maxlength: 72 %><br>
  <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter new password", class: "form-control", maxlength: 72 %><br>
  <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat new password", class: "form-control", maxlength: 72 %><br>
  <%= form.submit "Save" %>
<% end %>
