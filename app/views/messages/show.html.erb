<% cache @message do %>
    <h1 class="display-3"><%= @message.translated_message %></h1>
    <div data-controller="message" data-message="<%="#{@message.contents}"%>">
        <%= button_tag 'Play Message', {type: "button", class: "btn btn-outline-primary", data: {"action": "click->message#playMessage"}} %>
    </div>
<% end %>

<div id="empty-space">
</div>
<%= link_to "Back", messages_path, {class: 'btn btn-secondary'} %>
<%= link_to "Edit", edit_message_path(@message), {class: 'btn btn-secondary'} %>
<%= button_to "Delete", @message, method: :delete, data: { turbo_confirm: "Are you sure?"}, class: 'btn btn-warning'  %>
